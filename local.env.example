# Copy to local.env and fill in your own paths. local.env is read by build.ps1 and deploy.sh and is never published
# (see .gitignore). Forward slashes work everywhere.

# CommonLibVR (alandtse, ng branch) checkout - multi-target SE/AE/VR
COMMONLIB_DIR=D:/src/CommonLibVR
# vcpkg root (for spdlog, nlohmann-json, simpleini)
VCPKG_ROOT=D:/src/vcpkg
# Caprica Papyrus compiler (github.com/Orvid/Caprica)
CAPRICA=C:/tools/Caprica/Caprica.exe
# TESV_Papyrus_Flags.flg from your Creation Kit install (Data/Scripts/Source); Bethesda's file, not redistributed here
PAPYRUS_FLAGS=C:/Games/SkyrimSE/Data/Scripts/Source/TESV_Papyrus_Flags.flg
# Where deploy.sh copies the built mod (a mod-manager mod folder, e.g. MO2's mods/Battle Summaries)
MOD_DIR=C:/MO2/mods/Battle Summaries
# More modlists to deploy the same build into: any number of MOD_DIR_<NAME> lines
#MOD_DIR_OTHER=C:/OtherMO2/mods/Battle Summaries
# The game executable deploy.sh waits on (MO2 locks files while it runs)
GAME_EXE=SkyrimSE.exe
# package-source.sh refuses to export a file that matches this regular expression: your name, handles, machine paths
#PRIVATE_PATTERNS=yourname|D:[/\\]src|MyModlist
# Visual Studio 2022 Build Tools (defaults shown)
VCVARS=C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/VC/Auxiliary/Build/vcvars64.bat
CMAKE=C:/Program Files/CMake/bin/cmake.exe
NINJA=C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja/ninja.exe
